---
import { Clock3, Mail, MapPin, Phone } from '@lucide/astro';
import PageHero from '../../components/PageHero.astro';
import { contact } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Contacto" description="Dirección, teléfono y correo impresos en el catálogo CEDIVETS 2026.">
	<PageHero eyebrow="Contacto" title="Coordine su estudio y el envío de muestras." intro="El catálogo indica dirección, teléfono, correo y redes. Consulte el horario de recepción antes de despachar muestras." marker="07" />
	<section class="section">
		<div class="shell contact-grid">
			<article class="contact-card icon-motion-trigger">
				<div class="contact-card-top"><span>01 / Ubicación</span><div class="icon-surface" aria-hidden="true"><MapPin class="icon-motion-lift" size={24} stroke-width={1.8} /></div></div>
				<h2>Huaquillas, El Oro</h2>
				<p>{contact.address}</p>
			</article>
			<article class="contact-card">
				<div class="contact-card-top"><span>02 / Canales</span><div class="icon-surface" aria-hidden="true"><Phone size={24} stroke-width={1.8} /></div></div>
				<h2>Teléfono y correo</h2>
				<p class="contact-line icon-motion-trigger-within"><Phone class="icon-motion-tilt-left" size={17} stroke-width={1.9} aria-hidden="true" /><span>Teléfono: <a href={'tel:' + contact.phone}>{contact.phone}</a></span></p>
				<p class="contact-line icon-motion-trigger-within"><Mail class="icon-motion-lift" size={17} stroke-width={1.9} aria-hidden="true" /><span>Correo: <a href={'mailto:' + contact.email}>{contact.email}</a></span></p>
				<p>Facebook: {contact.facebook}<br />Instagram: {contact.instagram}</p>
			</article>
			<article class="contact-card icon-motion-trigger">
				<div class="contact-card-top"><span>03 / Atención</span><div class="icon-surface" aria-hidden="true"><Clock3 class="icon-motion-tilt-right" size={24} stroke-width={1.8} /></div></div>
				<h2>Horario</h2>
				<p>Días y franjas de recepción: <strong>Información por confirmar.</strong></p>
				<p>El catálogo recomienda coordinar horarios de recepción y entrega para servicios de mensajería.</p>
			</article>
		</div>
	</section>
	<section class="section section-soft">
		<div class="shell split-grid">
			<div class="split-copy"><p class="eyebrow">Antes del despacho</p><h2>Confirme disponibilidad y recepción.</h2></div>
			<div class="info-card"><h3>Prepare la solicitud</h3><p>Indique especie, tipo y localización de la muestra, fecha de toma, información clínica y estudios requeridos. Consulte la ficha del estudio para el recipiente y la conservación correspondientes.</p><span class="placeholder">Horario por confirmar</span></div>
		</div>
	</section>
</BaseLayout>
