---
import { ArrowRight } from '@lucide/astro';
import AreaIcon from '../../components/AreaIcon.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import { areas, services, type Service } from '../../data/services';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';

export function getStaticPaths() {
	return [
		...services.map((service) => ({ params: { slug: service.slug }, props: { service } })),
		...areas.filter((area) => area.id !== 'aviar').map((area) => ({ params: { slug: area.id }, props: { area } })),
	];
}

interface Props { service?: Service; area?: (typeof areas)[number] }
const { service, area } = Astro.props;
const related = area ? services.filter((item) => item.areaId === area.id) : [];
const headerAreaId = service?.areaId ?? area?.id;
const headerAccent = service?.accent ?? area?.accent;
---

<BaseLayout title={service?.name ?? area?.name ?? 'Servicios'} description={service ? service.name + '. Requisitos y tarifa del catálogo CEDIVETS 2026.' : area?.summary}>
	<PageHero eyebrow={service ? 'Estudio del catálogo 2026' : 'Área diagnóstica'} title={service?.name ?? area?.name ?? 'Servicios'} intro={service ? service.area : area?.summary ?? ''} marker="02">
		{headerAreaId && headerAccent && <AreaIcon slot="intro-icon" areaId={headerAreaId} size={22} class={`page-hero-area-icon accent-${headerAccent}`} />}
	</PageHero>
	{service ? (
		<section class="section">
			<div class="shell service-detail-grid">
				<div class="content-stack">
					<div class="notice"><strong>Catálogo 2026.</strong> Confirme disponibilidad y coordinación con CEDIVETS antes del envío.</div>
					<article class="info-card"><h2>Especificaciones y conservación</h2><p>{service.specifications}</p></article>
					{service.condition && <article class="info-card"><h2>Condición particular</h2><p>{service.condition}</p></article>}
					<article class="info-card"><h2>Preparación general</h2><p>Consulte también las recomendaciones de conservación, rotulado y embalaje del catálogo.</p><a class="text-link" href={withBase('/envio-de-muestras/')}>Ver envío de muestras <ArrowRight class="action-icon" size={17} stroke-width={1.9} aria-hidden="true" /></a></article>
					<p class="source-note">Fuente: Catálogo de precios CEDIVETS 2026, página {service.sourcePage}.</p>
				</div>
				<dl class="service-meta">
					<div><dt>Área</dt><dd>{service.area}</dd></div>
					<div><dt>Especie o ámbito</dt><dd>{service.species}</dd></div>
					{service.sampleType && <div><dt>Tipo de muestra</dt><dd>{service.sampleType}</dd></div>}
					<div><dt>Tiempo de entrega</dt><dd>{service.deliveryTime}</dd></div>
					{service.price !== null && <div><dt>Precio en catálogo</dt><dd>{service.price}</dd></div>}
					{service.price === null && <div><dt>Precio</dt><dd>No indicado en el catálogo</dd></div>}
				</dl>
			</div>
		</section>
	) : area && (
		<section class="section">
			<div class="shell">
				<p class="lead">Esta ruta conserva el acceso anterior al área. Cada estudio tiene ahora una ficha individual con las condiciones del catálogo.</p>
				<div class="feature-grid">
					{related.map((item) => <article class="feature-card"><h2>{item.name}</h2><p>{item.specifications}</p><a class="text-link" href={withBase('/servicios/' + item.slug + '/')}>Ver ficha <ArrowRight class="action-icon" size={17} stroke-width={1.9} aria-hidden="true" /></a></article>)}
				</div>
			</div>
		</section>
	)}
	<CtaBand />
</BaseLayout>
