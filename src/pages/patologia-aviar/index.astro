---
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import { services } from '../../data/services';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';

const avianCount = services.filter((service) => service.areaId === 'aviar').length;
---

<BaseLayout title="Patología aviar" description="Estudios de microbiología y control sanitario en aves del catálogo CEDIVETS 2026.">
	<PageHero eyebrow="Área especializada" title="Patología aviar" intro={'El catálogo 2026 documenta ' + avianCount + ' estudios de microbiología y control sanitario en aves, cada uno con su muestra, tiempo y tarifa.'} marker="03" />
	<section class="section">
		<div class="shell content-grid">
			<aside><p class="eyebrow">Alcance</p><h2>Condiciones distintas para cada prueba.</h2><p class="lead">Consulte la ficha individual antes de recolectar o enviar muestras.</p><a class="text-link" href={withBase('/servicios/?area=aviar')}>Ver estudios aviares <span aria-hidden="true">→</span></a></aside>
			<div class="content-stack">
				<article class="info-card"><h2>Necropsias</h2><p>El catálogo acepta cadáver u órganos representativos y recomienda enviar máximo 5 aves para necropsia.</p></article>
				<article class="info-card"><h2>Pools y controles</h2><p>Varios cultivos requieren pools de 3 a 4 aves; la investigación de Salmonella en huevos comerciales requiere de 15 a 30 huevos; el control de calidad pollo BB requiere 10 pollitos BB de 1 día. Estas cantidades corresponden solo a sus estudios respectivos.</p></article>
				<article class="info-card"><h2>Control sanitario oficial</h2><p>La serología y vigilancia de enfermedades aviares de control oficial se describen por separado como servicios en desarrollo o coordinados con laboratorios autorizados. Consulte disponibilidad y condiciones.</p></article>
			</div>
		</div>
	</section>
	<CtaBand />
</BaseLayout>
