---
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Investigación" description="Apoyo del Departamento de Apoyo Científico de CEDIVETS a proyectos de investigación.">
	<PageHero eyebrow="Apoyo científico" title="Investigación que conecta laboratorio y práctica veterinaria." intro="El Departamento de Apoyo Científico evalúa proyectos que requieren pruebas diagnósticas y puede ofrecer precios especiales." marker="05" />
	<section class="section">
		<div class="shell content-grid">
			<aside><p class="eyebrow">Departamento</p><h2>Apoyo Científico</h2><p class="lead">La investigación es parte del desarrollo científico y profesional que promueve CEDIVETS.</p></aside>
			<div class="content-stack">
				<article class="info-card"><h2>Presenta tu proyecto</h2><p>Detalla las pruebas que necesitas: histopatología, citología, microbiología o laboratorio clínico. El equipo evaluará la solicitud y el descuento aplicable. El PDF no indica un porcentaje ni garantiza una tarifa concreta.</p></article>
				<article class="info-card"><span class="placeholder">Información por confirmar</span><h2>Proyectos y publicaciones</h2><p>El catálogo no enumera líneas, proyectos, publicaciones, convenios ni responsables individuales.</p></article>
			</div>
		</div>
	</section>
	<CtaBand title="¿Desea presentar un proyecto?" text="Contacte a CEDIVETS con el tipo de pruebas diagnósticas requeridas." label="Ver contacto" href="/contacto/" />
</BaseLayout>
