---
import CtaBand from '../components/CtaBand.astro';
import { areas, services } from '../data/services';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout>
	<section class="hero">
		<div class="shell hero-grid">
			<div>
				<p class="eyebrow">Patología y laboratorio veterinario</p>
				<h1>Diagnóstico veterinario especializado para decisiones clínicas <span>más seguras.</span></h1>
					<p class="lead">CEDIVETS ofrece diagnóstico veterinario integral, preciso y oportuno para apoyar la práctica clínica con respaldo científico en El Oro y el sur del Ecuador.</p>
				<div class="hero-actions">
					<a class="button button-primary" href={withBase('/servicios/')}>Explorar servicios <span aria-hidden="true">→</span></a>
					<a class="button button-secondary" href={withBase('/envio-de-muestras/')}>Preparar una muestra</a>
				</div>
				<div class="hero-note">
					<strong>01</strong>
					<p>Primer laboratorio veterinario especializado en patología de la provincia de El Oro, Ecuador.</p>
				</div>
			</div>

			<div class="diagnostic-panel" aria-label="Representación conceptual del flujo diagnóstico; no es una fotografía de CEDIVETS">
				<div class="panel-header"><span>Flujo diagnóstico</span><span></span></div>
				<div class="diagnostic-orbit" aria-hidden="true">
					<i class="orbit-dot"></i><i class="orbit-dot"></i><i class="orbit-dot"></i>
				</div>
				<div class="panel-footer">
						<p><strong>Muestra → evidencia</strong>Diagrama conceptual del proceso diagnóstico</p>
					<span>CEDIVETS / 2026</span>
				</div>
			</div>
		</div>
	</section>

	<div class="proof-band">
		<div class="shell">
			<span>Catálogo 2026</span>
			<p>{services.length} estudios · {areas.length} áreas diagnósticas · requisitos de envío documentados</p>
		</div>
	</div>

	<section class="section">
		<div class="shell">
			<div class="section-heading">
				<div><p class="eyebrow">Explore CEDIVETS</p><h2>Diagnóstico, muestras y apoyo científico.</h2></div>
				<p>El catálogo reúne estudios de hematología, parasitología, citología, histopatología y microbiología, incluida el área aviar.</p>
			</div>
			<div class="area-grid">
				<article class="area-card" data-index="01"><p class="card-kicker">Estudios</p><h3>Servicios</h3><p>Revise las pruebas y sus requisitos individuales antes de enviar una muestra.</p><a class="text-link" href={withBase('/servicios/')}>Ver catálogo <span aria-hidden="true">→</span></a></article>
				<article class="area-card" data-index="02"><p class="card-kicker">Especialidades</p><h3>Áreas</h3><p>Conozca cómo se organizan las seis áreas del catálogo 2026.</p><a class="text-link" href={withBase('/areas/')}>Ver áreas <span aria-hidden="true">→</span></a></article>
				<article class="area-card" data-index="03"><p class="card-kicker">Preparación</p><h3>Envío de muestras</h3><p>Conservación, identificación y transporte según el tipo de muestra.</p><a class="text-link" href={withBase('/envio-de-muestras/')}>Ver requisitos <span aria-hidden="true">→</span></a></article>
			</div>
		</div>
	</section>

	<section class="section section-soft">
		<div class="shell split-grid">
			<div class="split-copy">
				<p class="eyebrow">Envío de muestras</p>
				<h2>La calidad del proceso empieza antes del laboratorio.</h2>
					<p class="lead">El catálogo indica cómo conservar, rotular y embalar las muestras. Cada ficha añade las condiciones particulares del estudio.</p>
					<a class="text-link" href={withBase('/envio-de-muestras/')}>Ver guía de muestras <span aria-hidden="true">→</span></a>
			</div>
			<ol class="step-list">
					<li><div><h3>Elegir el estudio</h3><p>Revise la muestra y las condiciones específicas de su ficha.</p></div></li>
					<li><div><h3>Conservar y rotular</h3><p>Use el fijador, recipiente o refrigeración que corresponda y anote los datos del caso.</p></div></li>
					<li><div><h3>Embalar</h3><p>Utilice envase hermético, bolsa secundaria sellada y caja externa.</p></div></li>
					<li><div><h3>Coordinar el envío</h3><p>Remita pronto la muestra y consulte el horario de recepción.</p></div></li>
			</ol>
		</div>
	</section>

	<section class="section">
		<div class="shell fact-panel">
			<p class="eyebrow eyebrow-light">Alcance institucional</p>
			<h2>Ciencia veterinaria conectada con la práctica clínica.</h2>
			<p>CEDIVETS busca fortalecer la medicina veterinaria con diagnósticos confiables, apoyo a la salud animal, control sanitario y decisiones clínicas eficaces.</p>
			<div class="fact-grid">
				<article><h3>Misión</h3><p>Diagnósticos veterinarios de alta calidad, precisos y oportunos, con un servicio ético y personalizado.</p></article>
				<article><h3>Visión</h3><p>Ser un centro de referencia en el sur del Ecuador y contribuir a la innovación y educación continua.</p></article>
				<article><h3>Equipo</h3><p>El catálogo menciona un equipo especializado; los perfiles individuales siguen pendientes.</p></article>
				<article><h3>Investigación</h3><p>El Departamento de Apoyo Científico evalúa proyectos para ofrecer precios especiales.</p></article>
			</div>
		</div>
	</section>

	<section class="section section-tint">
		<div class="shell split-grid">
			<div class="split-copy"><p class="eyebrow">Catálogo de precios 2026</p><h2>Cada estudio tiene sus propias condiciones.</h2></div>
			<div class="info-card"><p>Consulte especies, tipo de muestra, especificaciones, tiempo y precio por estudio. Algunos plazos o precios figuran como «Consultar» o no están indicados en el documento.</p><a class="text-link" href={withBase('/servicios/')}>Buscar estudios <span aria-hidden="true">→</span></a></div>
		</div>
	</section>

	<section class="section">
		<div class="shell split-grid">
			<div class="split-copy">
				<p class="eyebrow">Apoyo científico</p>
					<h2>Apoyo a proyectos de investigación.</h2>
			</div>
			<div class="content-stack">
				<article class="info-card"><h3>Departamento de Apoyo Científico</h3><p>Presenta tu proyecto y las pruebas requeridas. El equipo evaluará la solicitud para otorgar un descuento; el catálogo no fija un porcentaje.</p><a class="text-link" href={withBase('/investigacion/')}>Ver investigación <span aria-hidden="true">→</span></a></article>
				<article class="info-card"><h3>Control sanitario oficial</h3><p>Los servicios orientados a Agrocalidad están en desarrollo o se coordinan con laboratorios autorizados. Consulte disponibilidad, costos y muestreo.</p><a class="text-link" href={withBase('/servicios/')}>Ver alcance <span aria-hidden="true">→</span></a></article>
			</div>
		</div>
	</section>

	<CtaBand title="Coordine su estudio con CEDIVETS." text="Consulte disponibilidad y recepción antes de enviar una muestra." label="Ver contacto" href="/contacto/" />
</BaseLayout>
