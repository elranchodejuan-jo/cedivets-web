---
import CtaBand from '../components/CtaBand.astro';
import ServiceCatalog from '../components/ServiceCatalog.astro';
import { services } from '../data/services';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout>
	<section class="hero">
		<div class="shell hero-grid">
			<div>
				<p class="eyebrow">Patología y laboratorio veterinario</p>
				<h1>Diagnóstico veterinario especializado para decisiones clínicas <span>más seguras.</span></h1>
				<p class="lead">Una base digital clara para conectar evidencia diagnóstica, criterio profesional y atención veterinaria.</p>
				<div class="hero-actions">
					<a class="button button-primary" href={withBase('/servicios/')}>Explorar servicios <span aria-hidden="true">→</span></a>
					<a class="button button-secondary" href={withBase('/envio-de-muestras/')}>Preparar una muestra</a>
				</div>
				<div class="hero-note">
					<strong>01</strong>
					<p>Primer laboratorio veterinario especializado en patología de la provincia de El Oro, Ecuador.</p>
				</div>
			</div>

			<div class="diagnostic-panel" aria-label="Representación conceptual del flujo diagnóstico; no es una fotografía de CEDIVETS">
				<div class="panel-header"><span>Flujo diagnóstico</span><span></span></div>
				<div class="diagnostic-orbit" aria-hidden="true">
					<i class="orbit-dot"></i><i class="orbit-dot"></i><i class="orbit-dot"></i>
				</div>
				<div class="panel-footer">
					<p><strong>Muestra → evidencia</strong>Diagrama conceptual de la fase demo</p>
					<span>CEDIVETS / 2026</span>
				</div>
			</div>
		</div>
	</section>

	<div class="proof-band">
		<div class="shell">
			<span>Áreas iniciales</span>
			<p>Histopatología · Citología · Microbiología · Laboratorio clínico · Patología aviar</p>
		</div>
	</div>

	<section class="section">
		<div class="shell">
			<div class="section-heading">
				<div><p class="eyebrow">Servicios</p><h2>Una arquitectura preparada para crecer con el laboratorio.</h2></div>
				<p>Cada área dispone de una ficha ampliable con muestra, especificaciones, tiempo de entrega, especie y precio.</p>
			</div>
			<div class="area-grid">
				{services.slice(0, 5).map((service, index) => (
					<article class="area-card" data-index={String(index + 1).padStart(2, '0')}>
						<p class="card-kicker">Área diagnóstica</p>
						<h3>{service.area}</h3>
						<p>{service.summary}</p>
						<a class="text-link" href={withBase(`/servicios/${service.slug}/`)}>Conocer el área <span aria-hidden="true">→</span></a>
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="section section-soft">
		<div class="shell split-grid">
			<div class="split-copy">
				<p class="eyebrow">Envío de muestras</p>
				<h2>La calidad del proceso empieza antes del laboratorio.</h2>
				<p class="lead">El sitio deja preparado un recorrido para orientar la toma, identificación, conservación y coordinación de cada muestra.</p>
				<a class="text-link" href={withBase('/envio-de-muestras/')}>Ver guía preliminar <span aria-hidden="true">→</span></a>
			</div>
			<ol class="step-list">
				<li><div><h3>Confirmar el estudio</h3><p>Validar requisitos y disponibilidad con CEDIVETS.</p></div></li>
				<li><div><h3>Preparar e identificar</h3><p>Seguir el protocolo específico, aún pendiente de aprobación.</p></div></li>
				<li><div><h3>Coordinar la entrega</h3><p>Confirmar horario, transporte y recepción antes del envío.</p></div></li>
				<li><div><h3>Dar seguimiento</h3><p>Conservar el código o referencia acordada para la trazabilidad.</p></div></li>
			</ol>
		</div>
	</section>

	<section class="section">
		<div class="shell fact-panel">
			<p class="eyebrow eyebrow-light">Alcance institucional</p>
			<h2>Ciencia veterinaria conectada con la práctica clínica.</h2>
			<p>La web está organizada para explicar el alcance del laboratorio sin atribuir certificaciones, infraestructura o autorizaciones que todavía no han sido confirmadas.</p>
			<div class="fact-grid">
				<article><h3>Misión y visión</h3><p>Espacio preparado para la versión oficial aprobada por CEDIVETS.</p></article>
				<article><h3>Equipo</h3><p>Perfiles profesionales pendientes de nombres, cargos y fotografías autorizadas.</p></article>
				<article><h3>Infraestructura</h3><p>Inventario visual y técnico pendiente de validación institucional.</p></article>
				<article><h3>Investigación</h3><p>Base para proyectos, publicaciones y apoyo científico verificable.</p></article>
			</div>
		</div>
	</section>

	<section class="section section-tint">
		<div class="shell">
			<div class="section-heading">
				<div><p class="eyebrow">Catálogo</p><h2>Información preparada para buscar y comparar.</h2></div>
				<p>Los filtros funcionan en el navegador. Los datos comerciales y técnicos permanecen señalados como pendientes hasta su aprobación.</p>
			</div>
			<ServiceCatalog />
		</div>
	</section>

	<section class="section">
		<div class="shell split-grid">
			<div class="split-copy">
				<p class="eyebrow">Apoyo científico</p>
				<h2>Un espacio para investigar, documentar y compartir conocimiento.</h2>
			</div>
			<div class="content-stack">
				<article class="info-card"><h3>Departamento de Apoyo Científico / Investigación</h3><p>Estructura preparada para líneas de investigación, asesoría, colaboraciones, publicaciones y actividades académicas.</p><span class="placeholder">Información por confirmar</span></article>
				<article class="info-card"><h3>Agrocalidad</h3><p>Sección reservada para servicios en desarrollo o coordinados con laboratorios autorizados. Esta demo no afirma que CEDIVETS cuente con autorización de Agrocalidad.</p></article>
			</div>
		</div>
	</section>

	<CtaBand title="Hablemos cuando la información oficial esté lista." text="La sección de contacto está preparada para incorporar los canales, horarios y ubicación aprobados por CEDIVETS." label="Ver contacto" href="/contacto/" />
</BaseLayout>
