---
import { ArrowRight } from '@lucide/astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import { areas, services } from '../../data/services';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/urls';
---

<BaseLayout title="Áreas" description="Áreas diagnósticas descritas en el catálogo de precios CEDIVETS 2026.">
	<PageHero eyebrow="Áreas diagnósticas" title="Un recorrido por el alcance del catálogo." intro="Estas áreas organizan los estudios documentados en 2026. Consulte cada ficha para conocer muestra, condición particular, tiempo y precio." marker="03" />
	<section class="section">
		<div class="shell area-grid">
			{areas.map((area, index) => (
				<article class="area-card" data-index={String(index + 1).padStart(2, '0')}>
					<p class="card-kicker">{services.filter((service) => service.areaId === area.id).length} estudios</p>
					<h2>{area.name}</h2>
					<p>{area.summary}</p>
					<a class="text-link" href={withBase(area.id === 'aviar' ? '/patologia-aviar/' : '/servicios/' + area.id + '/')}>Explorar área <ArrowRight class="action-icon" size={17} stroke-width={1.9} aria-hidden="true" /></a>
				</article>
			))}
		</div>
	</section>
	<CtaBand title="Consulte el estudio concreto." text="El catálogo presenta por separado los requisitos y precios de cada prueba." label="Ver catálogo" href="/servicios/" />
</BaseLayout>
