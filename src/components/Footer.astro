---
import { contact, navigation, secondaryNavigation } from '../data/site';
import { withBase } from '../lib/urls';
import Brand from './Brand.astro';
---

<footer class="site-footer">
	<div class="shell footer-grid">
		<div>
			<Brand />
			<p class="footer-note">Diagnóstico veterinario con respaldo científico para decisiones clínicas más seguras.</p>
		</div>
		<div>
			<h2>Explorar</h2>
			<nav aria-label="Navegación del pie">
				{navigation.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
			</nav>
			<h2 class="footer-subheading">Más información</h2>
			<nav aria-label="Enlaces complementarios">
				{secondaryNavigation.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}
			</nav>
		</div>
		<div>
			<h2>Contacto</h2>
			<address>
				<p>{contact.address}</p>
				<p>Teléfono: <a href={'tel:' + contact.phone}>{contact.phone}</a></p>
				<p>Correo: <a href={'mailto:' + contact.email}>{contact.email}</a></p>
				<p>Facebook: {contact.facebook} · Instagram: {contact.instagram}</p>
			</address>
			<p>Horario de atención: información por confirmar.</p>
		</div>
	</div>
	<div class="shell footer-bottom">
		<p>© {new Date().getFullYear()} CEDIVETS. Catálogo de precios 2026; confirme disponibilidad.</p>
		<p>Sin seguimiento, cookies ni recolección de datos.</p>
	</div>
</footer>
