---
import { ArrowRight, LayoutGrid, PawPrint, RotateCcw, Search } from '@lucide/astro';
import { areas, services, speciesOptions } from '../data/services';
import { withBase } from '../lib/urls';

const fold = (value: string) =>
	value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('es').trim();
---

<section class="catalog" aria-labelledby="catalog-title">
	<div class="catalog-heading">
		<div>
			<p class="eyebrow">Catálogo oficial 2026</p>
			<h2 id="catalog-title">Encuentre un estudio</h2>
		</div>
		<p class="catalog-status" data-catalog-status aria-live="polite">{services.length} estudios</p>
	</div>

	<div class="catalog-filters" aria-label="Filtros del catálogo">
		<label class="search-field">
			<span>Buscar</span>
			<div class="filter-control"><Search size={20} stroke-width={1.9} aria-hidden="true" /><input data-filter-search type="search" placeholder="Ej. histopatología" autocomplete="off" /></div>
		</label>
		<label>
			<span>Área</span>
			<div class="filter-control"><LayoutGrid size={20} stroke-width={1.9} aria-hidden="true" /><select data-filter-area>
					<option value="">Todas las áreas</option>
					{areas.map((area) => <option value={area.id}>{area.name}</option>)}
				</select></div>
		</label>
		<label>
			<span>Especie</span>
			<div class="filter-control"><PawPrint size={20} stroke-width={1.9} aria-hidden="true" /><select data-filter-species>
					<option value="">Todas las especies</option>
					{speciesOptions.map((species) => <option value={fold(species)}>{species}</option>)}
				</select></div>
		</label>
		<button class="filter-reset" type="button" data-filter-reset><RotateCcw size={18} stroke-width={1.9} aria-hidden="true" />Limpiar filtros</button>
	</div>

	<div class="catalog-grid" data-catalog-grid>
		{services.map((service, index) => (
			<article
				class={`service-card accent-${service.accent}`}
				data-service-card
				data-search={fold([service.name, service.area, service.species, service.specifications, service.sampleType ?? ''].join(' '))}
				data-area={service.areaId}
				data-species={service.speciesTags.map(fold).join('|')}
			>
				<div class="service-card-top">
					<span>{String(index + 1).padStart(2, '0')}</span>
					<p>{service.area}</p>
				</div>
				<h3>{service.name}</h3>
				<p>{service.specifications}</p>
				<dl>
					<div><dt>Especie</dt><dd>{service.species}</dd></div>
					{service.sampleType && <div><dt>Muestra</dt><dd>{service.sampleType}</dd></div>}
					<div><dt>Entrega</dt><dd>{service.deliveryTime}</dd></div>
					{service.price !== null && <div><dt>Precio</dt><dd>{service.price}</dd></div>}
				</dl>
				{service.condition && <p class="service-condition">{service.condition}</p>}
				{service.price === null && <p class="service-condition">Precio no indicado en el catálogo.</p>}
				<a class="text-link" href={withBase(`/servicios/${service.slug}/`)}>Ver ficha <ArrowRight class="action-icon" size={17} stroke-width={1.9} aria-hidden="true" /></a>
			</article>
		))}
	</div>
	<p class="catalog-empty" data-catalog-empty hidden>No hay coincidencias con los filtros actuales.</p>
</section>

<script>
	const root = document.querySelector('.catalog');
	if (root) {
		const search = root.querySelector<HTMLInputElement>('[data-filter-search]');
		const area = root.querySelector<HTMLSelectElement>('[data-filter-area]');
		const species = root.querySelector<HTMLSelectElement>('[data-filter-species]');
		const cards = [...root.querySelectorAll<HTMLElement>('[data-service-card]')];
		const status = root.querySelector<HTMLElement>('[data-catalog-status]');
		const empty = root.querySelector<HTMLElement>('[data-catalog-empty]');
		const reset = root.querySelector<HTMLButtonElement>('[data-filter-reset]');

		const normalize = (value: string) =>
			value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLocaleLowerCase('es');
		const filter = () => {
			const term = normalize(search?.value ?? '');
			const selectedArea = area?.value ?? '';
			const selectedSpecies = species?.value ?? '';
			let visible = 0;
			cards.forEach((card) => {
				const matches = (!term || card.dataset.search?.includes(term)) &&
					(!selectedArea || card.dataset.area === selectedArea) &&
					(!selectedSpecies || card.dataset.species?.split('|').includes(selectedSpecies));
				card.hidden = !matches;
				if (matches) visible += 1;
			});
			if (status) status.textContent = `${visible} ${visible === 1 ? 'resultado' : 'resultados'}`;
			if (empty) empty.hidden = visible !== 0;
		};

		search?.addEventListener('input', filter);
		area?.addEventListener('change', filter);
		species?.addEventListener('change', filter);
		reset?.addEventListener('click', () => {
			if (search) search.value = '';
			if (area) area.value = '';
			if (species) species.value = '';
			filter();
			search?.focus();
		});
		const requestedArea = new URLSearchParams(window.location.search).get('area');
		if (area && requestedArea && [...area.options].some((option) => option.value === requestedArea)) {
			area.value = requestedArea;
			filter();
		}
	}
</script>
