---
import { ArrowRight } from '@lucide/astro';
import { withBase } from '../lib/urls';

interface Props {
	title?: string;
	text?: string;
	label?: string;
	href?: string;
}

const {
	title = '¿Necesita coordinar una muestra?',
	text = 'Revise la preparación documentada en el catálogo y confirme la recepción antes de realizar un envío.',
	label = 'Cómo enviar una muestra',
	href = '/envio-de-muestras/',
} = Astro.props;
---

<section class="cta-wrap">
	<div class="shell cta-band">
		<div>
			<p class="eyebrow eyebrow-light">Siguiente paso</p>
			<h2>{title}</h2>
			<p>{text}</p>
		</div>
		<a class="button button-light" href={withBase(href)}>{label}<ArrowRight class="action-icon" size={18} stroke-width={1.9} aria-hidden="true" /></a>
	</div>
</section>
