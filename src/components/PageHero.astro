---
interface Props {
	eyebrow: string;
	title: string;
	intro: string;
	marker?: string;
}

const { eyebrow, title, intro, marker = '01' } = Astro.props;
const hasIntroIcon = Astro.slots.has('intro-icon');
---

<section class="page-hero">
	<div class="shell page-hero-grid">
		<div>
			<p class="eyebrow">{eyebrow}</p>
			<h1>{title}</h1>
			<p class:list={['lead', { 'page-hero-area': hasIntroIcon }]}><slot name="intro-icon" /><span>{intro}</span></p>
		</div>
		<div class="page-marker" aria-hidden="true">
			<span>{marker}</span>
			<i></i>
		</div>
	</div>
</section>
