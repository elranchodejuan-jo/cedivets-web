---
import { navigation, secondaryNavigation } from '../data/site';
import { withBase } from '../lib/urls';
import Brand from './Brand.astro';

interface Props {
	pathname: string;
}

const { pathname } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localPath = base && pathname.startsWith(base) ? pathname.slice(base.length) || '/' : pathname;
const currentPath = localPath.endsWith('/') ? localPath : localPath + '/';
const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href);
---

<header class="site-header">
	<div class="shell header-inner">
		<Brand />
		<nav class="desktop-nav" aria-label="Navegación principal">
			{navigation.map((item) => (
				<a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
					{item.label}
				</a>
			))}
		</nav>
		<details class="mobile-nav" data-mobile-nav>
			<summary aria-label="Abrir menú de navegación" data-mobile-toggle>
				<span></span><span></span><span></span>
			</summary>
			<nav aria-label="Navegación móvil">
				{navigation.map((item) => (
					<a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
						{item.label}
					</a>
				))}
			</nav>
		</details>
	</div>
	<nav class="shell secondary-nav" aria-label="Navegación complementaria">
		{secondaryNavigation.map((item) => (
			<a href={withBase(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
		))}
	</nav>
</header>

<script>
	document.querySelectorAll<HTMLDetailsElement>('[data-mobile-nav]').forEach((menu) => {
		const toggle = menu.querySelector<HTMLElement>('[data-mobile-toggle]');
		menu.addEventListener('toggle', () => {
			toggle?.setAttribute('aria-label', menu.open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
		});
	});
</script>
